# Copy to .env (committed-safe values) and .env.local (secrets, gitignored)
# and fill in real values. Never commit actual secrets.

MATCHING_ENGINE=
AI_SERVICE_URL=
INTERNAL_API_KEY=
AI_FALLBACK=
LLM_PROVIDER=
DB_USER=
DB_HOST=
DB_DATABASE=
DB_PASSWORD=
DB_PORT=

# Admin secret-code sign-in (Deliverable 4, bug 3). Generate with
# `node scripts/generate-admin-code.js` - that script writes this to
# .env.local for you; never set it by hand, and never share a real value.
ADMIN_ACCESS_CODE_HASH=
