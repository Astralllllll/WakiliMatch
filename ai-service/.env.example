# Shared secret Express must send as the X-Internal-Key header.
# This service must never be exposed to the public internet directly.
INTERNAL_API_KEY=change-me-to-a-long-random-value

# Where build_index.py writes, and main.py reads, the index files.
ARTIFACTS_DIR=./artifacts

# Host/port for `uvicorn main:app`
HOST=127.0.0.1
PORT=8000
